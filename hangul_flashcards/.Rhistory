# load lib ----------------------------------------------------------------
library(shiny)
library(readxl)
library(magrittr)
# load df -----------------------------------------------------------------
words <- read_xlsx("df.xlsx")
# define UI ---------------------------------------------------------------
ui <- fluidPage(
titlePanel(title = "Quiz yourself Hangul pronunciation: the app pops basic Hangul words and English translations, and only reveals romanization when you let it!",
windowTitle = "Hangul Flashcards"),
sidebarLayout(
sidebarPanel(
actionButton("newWord", "Test me another one!"),
br(), br(),
actionButton("reveal", "Reveal romanization")
),
mainPanel(
tags$h2("Hangul"),
textOutput("hangulOut"),
tags$h3("English"),
textOutput("englishOut"),
tags$h3("Romanization"),
textOutput("romanOut")
)
)
)
# define server -----------------------------------------------------------
server <- function(input, output, session) {
# Reactive values store the current word and whether romanization is revealed.
current <- reactiveValues(
hangul  = "",
english = "",
roman   = "",
showRoman = FALSE
)
# Function to get a new random word from the data frame.
newWord <- function() {
idx <- sample(1:nrow(words), 1)
current$hangul  <- words$hangul[idx]
current$english <- words$english[idx]
current$roman   <- words$roman[idx]
current$showRoman <- FALSE
}
# Generate an initial random word when the app starts.
newWord()
# When the "Test me another one!" button is clicked, get a new word.
observeEvent(input$newWord, {
newWord()
})
# When the "Reveal romanization" button is clicked, show the romanization.
observeEvent(input$reveal, {
current$showRoman <- TRUE
})
# Display outputs:
output$hangulOut <- renderText({
current$hangul
})
output$englishOut <- renderText({
current$english
})
output$romanOut <- renderText({
if (current$showRoman) current$roman else ""
})
}
# launch app --------------------------------------------------------------
shinyApp(ui, server)
runApp('learning_hangul.R')
runApp('learning_hangul.R')
runApp('learning_hangul.R')
runApp('learning_hangul.R')
